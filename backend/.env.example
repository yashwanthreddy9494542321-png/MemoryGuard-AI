# MemoraGuard AI - Backend Environment Configuration Template
# Copy this file to backend/.env and replace placeholders with your credentials.

# Application Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./data/memoraguard.db

# Qdrant Vector Database
# Mode: "local" (uses embedded local disk storage) or "hosted" (connects to Qdrant Cloud / Docker)
QDRANT_MODE=local
# Optional remote URL if QDRANT_MODE=hosted (e.g., https://xyz.cloud.qdrant.io:6333 or http://localhost:6333)
QDRANT_URL=
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=memoraguard_memories

# Lyzr Agent Studio Configuration
# Real endpoint: https://agent-prod.studio.lyzr.ai/v3/inference/chat/
LYZR_API_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
LYZR_API_KEY=your_lyzr_api_key_here
LYZR_AGENT_ID=your_agent_id_here
LYZR_DEFAULT_USER_ID=user@example.com
LYZR_SESSION_ID=your_session_id_here

# OMI Wearable Integration (Optional text sync / import)
OMI_API_KEY=your_omi_api_key_here
OMI_API_URL=https://api.omi.me/v1

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
DEFAULT_VISIBILITY=private
